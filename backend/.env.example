# ==============================================
# 淬 · Cui — 环境配置
# ==============================================
# cp .env.example .env && 填入真实值

# ----------------------------------------------
# LLM 配置 (必填)
# ----------------------------------------------
# Provider: anthropic | openai
# "openai" 兼容 DeepSeek / 百炼 / Together / Groq / OpenRouter
CUI_LLM_PROVIDER=anthropic
CUI_LLM_KEY=sk-ant-your-key
CUI_LLM_MODEL=claude-sonnet-5
CUI_LLM_BASE_URL=https://api.anthropic.com

# --- DeepSeek 示例 ---
# CUI_LLM_PROVIDER=openai
# CUI_LLM_KEY=sk-your-key
# CUI_LLM_MODEL=deepseek-chat
# CUI_LLM_BASE_URL=https://api.deepseek.com/v1

# ----------------------------------------------
# 学术搜索 API (推荐, 不填也能用)
# ----------------------------------------------
# NCBI / PubMed (无 key 也能用, 3 req/s; 填邮箱进 polite pool, 有 key 提到 10 req/s)
# NCBI_EMAIL=your.email@example.com
# NCBI_API_KEY=your-ncbi-api-key

# OpenAlex (无需 key; 填邮箱进入 polite pool, 更稳的限流)
# OPENALEX_CONTACT=your.email@example.com

# Semantic Scholar (无 key 也能用, 但 keyless 限流极严; 有 key 走 x-api-key 提速)
# S2_API_KEY=your-s2-key

# Google Scholar (via SerpApi, 免费 100 次/月)
# SERPAPI_KEY=your-serpapi-key

# ----------------------------------------------
# 数据目录 (可选)
# ----------------------------------------------
# CUI_DATA_DIR=~/.cui/data

# ----------------------------------------------
# 数据库 (PostgreSQL)
# ----------------------------------------------
CUI_DATABASE_URL=postgresql://localhost:5432/cui
